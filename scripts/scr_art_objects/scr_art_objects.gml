/// scr_art_objects -- pixel art for every thing a player can act on.
///
/// Every object lives on a 16x16 grid and shares ONE palette, so the whole
/// room reads as a single art set. "." means see-through.
/// The same art is re-used, tinted white, as the icon inside the round
/// action button above the object (see draw_action_button).

#macro OBJ_GRID 16

/// @desc Shared object palette. One letter per colour.
function art_palette() {
    if (variable_global_exists("art_pal_cache")) return global.art_pal_cache;
    global.art_pal_cache = {
        k : make_colour_rgb( 30,  34,  54),   // ink / outline
        x : make_colour_rgb( 70,  76, 100),   // dark grey
        l : make_colour_rgb(176, 184, 200),   // light grey
        s : make_colour_rgb(222, 228, 238),   // steel / silver
        W : make_colour_rgb(252, 250, 244),   // white
        w : make_colour_rgb(166, 112,  62),   // wood
        n : make_colour_rgb(112,  72,  44),   // dark wood
        t : make_colour_rgb(236, 206, 152),   // tan
        r : make_colour_rgb(226,  92,  86),   // red
        o : make_colour_rgb(242, 156,  72),   // orange
        y : make_colour_rgb(255, 215,   0),   // gold
        g : make_colour_rgb(110, 196, 120),   // green
        b : make_colour_rgb( 86, 146, 236),   // blue
        c : make_colour_rgb( 96, 214, 226),   // cyan
        p : make_colour_rgb(228, 124, 168),   // pink
        v : make_colour_rgb(152, 120, 216),   // violet
        e : make_colour_rgb( 36,  40,  48),   // screen black
        f : make_colour_rgb(240, 198, 160)    // skin
    };
    return global.art_pal_cache;
}

